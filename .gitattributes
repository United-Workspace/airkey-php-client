# Git checkout/commit normalization
* text=auto eol=lf
*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Packagist export ignore
# Strips development, generator, and CI files from Composer distribution archives
/.generator export-ignore
/.github export-ignore
/.openapi-generator-ignore export-ignore
/.php_cs export-ignore
/phpunit.xml.dist export-ignore
/test export-ignore
.gitignore export-ignore
.gitattributes export-ignore
